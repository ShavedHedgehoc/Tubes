{
  "name": "tubes-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tubes production monitoring monorepo",
  "workspaces": [
    "api_tubes",
    "tubes_application",
    "new-app"
  ],
  "scripts": {
    "install:all": "npm install",
    "generate": "npm run generate -w api_tubes",
    "lint:all": "npm run lint --workspaces",
    "types:all": "npm run lint:types --workspaces",
    "build:all": "npm run build --workspaces",
    "check:all": "npm run types:all && npm run build:all",
    "knip": "knip",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "pre-flight": "npm run prettier:check && npm run types:all && npm run lint:all && npm run knip && npm run build:all"
  },
  "devDependencies": {
    "knip": "^5.85.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@oxc-resolver/binding-linux-x64-gnu": "1.0.0",
    "@rollup/rollup-linux-x64-gnu": "4.12.0",
    "lightningcss-linux-x64-gnu": "1.24.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.0.0"
  },
  "overrides": {
    "@oxc-resolver/binding-linux-x64-gnu": "$@oxc-resolver/binding-linux-x64-gnu",
    "@rollup/rollup-linux-x64-gnu": "$@rollup/rollup-linux-x64-gnu",
    "lightningcss-linux-x64-gnu": "$lightningcss-linux-x64-gnu",
    "@tailwindcss/oxide-linux-x64-gnu": "$@tailwindcss/oxide-linux-x64-gnu"
  },
  "os": [
    "win32",
    "linux"
  ],
  "cpu": [
    "x64"
  ]
}
