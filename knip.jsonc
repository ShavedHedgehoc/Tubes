{
  "$schema": "https://unpkg.com",
  "workspaces": {
    ".": {
      "project": ["*.{ts,js,jsonc}"],
    },
    "api_tubes": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["prisma"],
    },
    "tubes_application": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@emotion/styled", "framer-motion"],
    },
    "new_app": {
      "entry": ["pages/**/*.{js,jsx,ts,tsx}", "app/**/*.{js,jsx,ts,tsx}"], // Next.js
      "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],
    },
    "db": {
      "project": [],
      "ignoreDependencies": ["@prisma/client"],
    },
  },
  "ignoreExportsUsedInFile": true,
  "ignore": ["new-app/src/shared/ui/**"],
}
