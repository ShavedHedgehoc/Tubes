FROM node:20-alpine as build-step 

WORKDIR /app

# Копируем только файлы зависимостей для кэширования слоев
COPY ./tubes_application/package*.json ./
# Устанавливаем зависимости (ci быстрее и чище для продакшена)
RUN npm ci

# Копируем остальные исходники (убедись, что vite.config.ts/js попадает сюда)
COPY ./tubes_application/ ./

# Собираем проект (Vite по умолчанию кладет билд в папку /dist)
RUN npm run build

# Stage 2: Раздача статики
FROM nginx:stable-alpine

# Очищаем дефолтную папку nginx
RUN rm -rf /usr/share/nginx/html/*

# Копируем билд из первой стадии
COPY --from=build-step /app/dist /usr/share/nginx/html

# Копируем твой кастомный конфиг, который мы правили ранее
COPY docker/tubes/nginx.conf /etc/nginx/nginx.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
