# --- Этап сборки (Builder) ---
FROM node:20-slim AS builder
RUN apt-get update && apt-get install -y openssl python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Копируем КОРНЕВЫЕ манифесты
COPY package.json package-lock.json ./
# 2. Копируем манифест API
COPY api_tubes/package.json ./api_tubes/

# 3. Устанавливаем всё (включая dev-зависимости для генерации и билда)
RUN npm ci -w api_tubes

# 4. Копируем исходники API
COPY api_tubes/ ./api_tubes/

# 5. Генерируем Prisma (явно указываем путь к схеме, т.к. мы в /app)
RUN npx prisma generate --schema=./api_tubes/prisma/schema.prisma

# 6. Собираем проект
RUN npm run build -w api_tubes


# --- Этап выполнения (Runtime) ---
FROM node:20-slim AS runtime
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# ВАЖНО: Работаем от корня /app, чтобы сохранить иерархию монорепозитория
WORKDIR /app

# 1. Копируем КОРНЕВЫЕ node_modules (там лежит бинарник prisma и клиент)
COPY --from=builder /app/node_modules ./node_modules

# 2. Копируем всё содержимое воркспейса (dist, prisma, package.json)
COPY --from=builder /app/api_tubes ./api_tubes

# 3. Переходим в папку API для запуска команд
WORKDIR /app/api_tubes

EXPOSE 7100

# Теперь npx найдет бинарник в ../node_modules/.bin и НЕ будет ничего скачивать
CMD ["npm", "run", "start:migrate:prod"]
