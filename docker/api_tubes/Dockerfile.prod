# --- Этап сборки (Builder) ---
FROM node:20-slim AS builder
# Установка системных зависимостей для Prisma и сборки нативных модулей
RUN apt-get update && apt-get install -y openssl python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Копируем корневые конфиги (lock-файл обязателен для npm ci)
COPY package.json package-lock.json ./

# 2. Копируем манифест и саму папку воркспейса
# (Копируем всё сразу, чтобы подтянулись tsconfig и prisma/schema.prisma)
COPY api_tubes/ ./api_tubes/

# 3. Устанавливаем зависимости для воркспейса из КОРНЯ
# npm ci прочитает корневой lock и установит всё в /app/node_modules
RUN npm ci -w api_tubes

# 4. Генерируем Prisma Client
# Явно указываем путь к схеме, так как мы в корне /app
RUN npx prisma generate --schema=./api_tubes/prisma/schema.prisma

# 5. Собираем проект
RUN npm run build -w api_tubes



# --- Этап выполнения ---
FROM node:20-slim AS runtime
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app/api_tubes

# Копируем только необходимое из builder
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/api_tubes/dist ./dist
COPY --from=builder /app/api_tubes/package.json ./package.json
COPY --from=builder /app/api_tubes/prisma ./prisma

EXPOSE 7100
CMD ["npm", "run", "start:migrate:prod"]
