# --- Этап сборки ---
FROM node:20-slim AS builder
# Для Prisma на Linux нужны зависимости
RUN apt-get update && apt-get install -y openssl python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем корневые файлы и манифесты нужных воркспейсов
COPY package.json package-lock.json ./
COPY api_tubes/package.json ./api_tubes/

# Устанавливаем зависимости только для API (используя общий замок)
RUN npm ci -w api_tubes

# Копируем исходники API
COPY api_tubes/ ./api_tubes/

# Собираем
WORKDIR /app/api_tubes
RUN npx prisma generate
RUN npm run build



# # --- Этап выполнения ---
# FROM node:20-slim AS runtime
# RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# WORKDIR /app/api_tubes

# # Копируем только необходимое из builder
# COPY --from=builder /app/node_modules /app/node_modules
# COPY --from=builder /app/api_tubes/dist ./dist
# COPY --from=builder /app/api_tubes/package.json ./package.json
# COPY --from=builder /app/api_tubes/prisma ./prisma

# EXPOSE 7100
# CMD ["npm", "run", "start:migrate:prod"]
FROM node:20-slim AS runtime
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# ВАЖНО: работаем от корня /app, чтобы сохранить структуру монорепозитория
WORKDIR /app

# Добавляем путь к корневым бинарникам в системный PATH
ENV PATH="/app/node_modules/.bin:${PATH}"

# Копируем корневые node_modules (там лежит prisma и @prisma/client)
COPY --from=builder /app/node_modules ./node_modules
# Копируем папку приложения
COPY --from=builder /app/api_tubes ./api_tubes

# Переходим в папку API для запуска команд
WORKDIR /app/api_tubes

EXPOSE 7100

# Теперь любая команда (prisma, nest и т.д.) будет доступна глобально
CMD ["npm", "run", "start:migrate:prod"]


